+static __global__ void sort_neighbor_face_ids_kernel(
+    int* neighbor_face_ids,
+    const int* neighbor_face_ids_offset,
+    const int V
+) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= V) return;
+    const int begin = neighbor_face_ids_offset[tid];
+    const int end = neighbor_face_ids_offset[tid + 1];
+    for (int i = begin + 1; i < end; ++i) {
+        const int value = neighbor_face_ids[i];
+        int j = i - 1;
+        while (j >= begin && neighbor_face_ids[j] > value) {
+            neighbor_face_ids[j + 1] = neighbor_face_ids[j];
+            --j;
+        }
+        neighbor_face_ids[j + 1] = value;
+    }
+}
